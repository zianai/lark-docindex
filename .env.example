# Copy this file to .env and fill in your own Feishu/Lark resource IDs.
# Do not commit .env.

# Required for Base operations.
BASE_TOKEN=

# Existing/source table used by import, scoring, and as default V3 source.
TABLE_ID=

# Optional explicit source table for V3 rebuild. Defaults to TABLE_ID.
SOURCE_TABLE_ID=

# Optional names for newly created V3 resources.
V3_TABLE_NAME=文档索引
V3_DASHBOARD_NAME=文档索引管理

# Required only for scripts/sync_dashboard_v2.py.
DASHBOARD_ID=
TABLE_NAME=文档索引

# Optional scoring owner bonus.
OWNER_BONUS_KEYWORD=
